# Monorepo Docker builds (context = repo root).
# Stub apps without Dockerfiles to package.json only for bun.lock workspace resolution.
# Apps with Dockerfiles ship full source (not listed below).
# zeo-music-worker is stub-only here — it depends on @livekit/rtc-node (native).
# markitdown / imposter-art are skipped from this deploy rollout.

node_modules
**/.git
**/.turbo
**/.svelte-kit
**/.astro
**/node_modules
**/dist
**/build
**/coverage
# Needed by apps/heimdall image (BMAD War Room). Other Dockerfiles do not COPY it.
# _bmad-output
.agents
apps/imposter-art

apps/markitdown/**
!apps/markitdown/package.json
apps/zeo-music-worker/**
!apps/zeo-music-worker/package.json
