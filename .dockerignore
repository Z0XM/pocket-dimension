# Used when building from monorepo root (zeo / music-worker Dockerfiles).
# Keep every workspace package.json so `bun install --frozen-lockfile` can
# resolve the lockfile graph even when app sources are omitted.
node_modules
**/.git
**/.turbo
**/.svelte-kit
_bmad-output
.agents

# Omit bulky app sources; re-include package.json for workspace resolution.
apps/auth-service/**
!apps/auth-service/package.json
apps/chhan-chhan/**
!apps/chhan-chhan/package.json
apps/howwasyourday/**
!apps/howwasyourday/package.json
apps/markitdown/**
!apps/markitdown/package.json
apps/me-via-you/**
!apps/me-via-you/package.json
apps/pocket/**
!apps/pocket/package.json
apps/rhymes/**
!apps/rhymes/package.json
apps/watchlist/**
!apps/watchlist/package.json
