{
  "name": "pocket-dimension",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "./scripts/turbo-no-prefix.sh run build --concurrency=1",
    "dev": "./scripts/turbo-no-prefix.sh run dev",
    "build:shared:auth": "./scripts/turbo-no-prefix.sh run build --filter=@pocket-dimension/auth",
    "build:shared:db": "./scripts/turbo-no-prefix.sh run build --filter=@pocket-dimension/db",
    "build:shared:utils": "./scripts/turbo-no-prefix.sh run build --filter=@pocket-dimension/utils",
    "build:app:auth": "./scripts/turbo-no-prefix.sh run build --filter=@pocket-dimension/auth-service",
    "build:app:watchlist": "./scripts/turbo-no-prefix.sh run build --filter=@pocket-dimension/watchlist",
    "build:app:rhymes": "./scripts/turbo-no-prefix.sh run build --filter=@pocket-dimension/rhymes",
    "build:app:howwasyourday": "./scripts/turbo-no-prefix.sh run build --filter=@pocket-dimension/howwasyourday",
    "build:app:chhan-chhan": "./scripts/turbo-no-prefix.sh run build --filter=@pocket-dimension/chhan-chhan",
    "build:app:me-via-you": "./scripts/turbo-no-prefix.sh run build --filter=@pocket-dimension/me-via-you",
    "build:app:markitdown": "./scripts/turbo-no-prefix.sh run build --filter=@pocket-dimension/markitdown",
    "build:app:pocket": "./scripts/turbo-no-prefix.sh run build --filter=@pocket-dimension/pocket",
    "dev:app:chhan-chhan": "./scripts/turbo-no-prefix.sh run dev --filter=@pocket-dimension/chhan-chhan",
    "dev:app:me-via-you": "./scripts/turbo-no-prefix.sh run dev --filter=@pocket-dimension/me-via-you",
    "dev:app:rhymes": "./scripts/turbo-no-prefix.sh run dev --filter=@pocket-dimension/rhymes",
    "dev:app:howwasyourday": "./scripts/turbo-no-prefix.sh run dev --filter=@pocket-dimension/howwasyourday",
    "dev:app:auth": "./scripts/turbo-no-prefix.sh run dev --filter=@pocket-dimension/auth-service",
    "dev:app:watchlist": "./scripts/turbo-no-prefix.sh run dev --filter=@pocket-dimension/watchlist",
    "dev:app:markitdown": "./scripts/turbo-no-prefix.sh run dev --filter=@pocket-dimension/markitdown",
    "dev:app:pocket": "./scripts/turbo-no-prefix.sh run dev --filter=@pocket-dimension/pocket",
    "db:generate": "./scripts/turbo-no-prefix.sh run db:generate --filter=@pocket-dimension/db --",
    "db:migrate": "./scripts/turbo-no-prefix.sh run db:migrate --filter=@pocket-dimension/db",
    "db:studio": "./scripts/turbo-no-prefix.sh run db:studio --filter=@pocket-dimension/db",
    "lint": "./scripts/turbo-no-prefix.sh run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck --concurrency=1",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build --filter='[HEAD^1]' && changeset publish",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@changesets/cli": "latest",
    "@types/bun": "^1.3.5",
    "@typescript/native-preview": "^7.0.0-dev.20260405.1",
    "@vitest/coverage-v8": "latest",
    "husky": "latest",
    "lint-staged": "latest",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^3.4.1",
    "turbo": "^2.7.2",
    "typescript": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/**",
    "shared/**",
    "scripts/**"
  ],
  "overrides": {
    "kysely": "0.28.17"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.0",
    "better-auth": "^1.4.9",
    "elysia": "^1.4.19"
  }
}
