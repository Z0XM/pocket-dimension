{
  "name": "pocket-dimension",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:auth": "turbo run dev --filter=@pocket-dimension/auth-service",
    "dev:watchlist:svelte": "turbo run dev --filter=@pocket-dimension/watchlist-svelte",
    "db:studio": "turbo run db:studio --filter=@pocket-dimension/db",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build --filter='[HEAD^1]' && changeset publish",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@changesets/cli": "latest",
    "@types/bun": "^1.3.5",
    "@vitest/coverage-v8": "latest",
    "husky": "latest",
    "lint-staged": "latest",
    "turbo": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "packageManager": "bun@1.1.38",
  "workspaces": [
    "apps/**",
    "shared/**"
  ],
  "dependencies": {
    "@elysiajs/cors": "^1.4.0",
    "better-auth": "^1.4.9",
    "elysia": "^1.4.19"
  }
}
