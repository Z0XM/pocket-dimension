{
  "name": "pocket-dimension",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "./scripts/turbo-no-prefix.sh run build",
    "dev": "./scripts/turbo-no-prefix.sh run dev",
    "build:shared:auth": "./scripts/turbo-no-prefix.sh run build --filter=@pocket-dimension/auth",
    "build:shared:db": "./scripts/turbo-no-prefix.sh run build --filter=@pocket-dimension/db",
    "build:shared:utils": "./scripts/turbo-no-prefix.sh run build --filter=@pocket-dimension/utils",
    "build:app:auth": "./scripts/turbo-no-prefix.sh run build --filter=@pocket-dimension/auth-service",
    "build:app:watchlist": "./scripts/turbo-no-prefix.sh run build --filter=@pocket-dimension/watchlist",
    "dev:app:auth": "./scripts/turbo-no-prefix.sh run dev --filter=@pocket-dimension/auth-service",
    "dev:app:watchlist": "./scripts/turbo-no-prefix.sh run dev --filter=@pocket-dimension/watchlist",
    "db:generate": "./scripts/turbo-no-prefix.sh run db:generate --filter=@pocket-dimension/db --",
    "db:migrate": "./scripts/turbo-no-prefix.sh run db:migrate --filter=@pocket-dimension/db",
    "db:studio": "./scripts/turbo-no-prefix.sh run db:studio --filter=@pocket-dimension/db",
    "lint": "./scripts/turbo-no-prefix.sh run lint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build --filter='[HEAD^1]' && changeset publish",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@changesets/cli": "latest",
    "@types/bun": "^1.3.5",
    "@vitest/coverage-v8": "latest",
    "husky": "latest",
    "lint-staged": "latest",
    "turbo": "^2.7.2",
    "typescript": "latest",
    "vitest": "latest"
  },
  "packageManager": "bun@1.1.38",
  "workspaces": [
    "apps/**",
    "shared/**",
    "scripts/**"
  ],
  "dependencies": {
    "@elysiajs/cors": "^1.4.0",
    "better-auth": "^1.4.9",
    "elysia": "^1.4.19"
  }
}
