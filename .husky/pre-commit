#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "Running lint-staged..."
bunx lint-staged || exit 1

echo "Running typecheck on changed packages..."
bunx turbo run typecheck --filter='[HEAD^1]' --concurrency=1 || exit 1

if [ "${SKIP_PRE_COMMIT_BUILD:-}" = "1" ]; then
  echo "Skipping build (SKIP_PRE_COMMIT_BUILD=1)."
  exit 0
fi

echo "Running build on changed packages..."
bunx turbo run build --filter='[HEAD^1]' --filter='!@pocket-dimension/scripts' --concurrency=1 || exit 1
