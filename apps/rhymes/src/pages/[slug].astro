---
import RhymesAppShell from "../components/RhymesAppShell.astro";
import { loadRhymes } from "../lib/loadRhymes";

const rhymes = loadRhymes();
const { slug } = Astro.params;

const matchingRhyme = slug ? rhymes.find((rhyme) => rhyme.slug === slug) : undefined;

if (!matchingRhyme) {
  return Astro.redirect("/");
}
---

<RhymesAppShell rhymes={rhymes} initialSlug={matchingRhyme.slug} />
