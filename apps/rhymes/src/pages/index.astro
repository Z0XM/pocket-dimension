---
import RhymeSelector from "../components/RhymeSelector.svelte";
import Layout from "../layouts/Layout.astro";

// Get frontmatter from parsed markdown and raw content for line breaks
const rhymeModules = import.meta.glob("../assets/rhymes/*.md", { eager: true });
const rawRhymeModules = import.meta.glob("../assets/rhymes/*.md", {
  eager: true,
  query: "?raw",
});

// Combine frontmatter with raw content
const rhymes = Object.keys(rhymeModules)
  .map((path) => {
    const parsed = rhymeModules[path] as { frontmatter: Record<string, any> };
    const raw = rawRhymeModules[path] as { default: string };

    // Extract content after frontmatter
    const frontmatterRegex = /^---\s*\n([\s\S]*?)\n---\s*\n([\s\S]*)$/;
    const match = raw.default.match(frontmatterRegex);
    const content = match ? match[2].trim() : raw.default;

    // Parse order from frontmatter string if it's not in parsed frontmatter or is null
    let order = parsed.frontmatter.order;
    if ((order === undefined || order === null) && match) {
      const frontmatterText = match[1];
      // Match order: 156 or order:156 (with or without quotes)
      const orderMatch = frontmatterText.match(/^order:\s*(.+?)(?:\n|$)/m);
      if (orderMatch) {
        const orderValue = orderMatch[1].trim().replace(/^['"]|['"]$/g, "");
        const parsedOrder = Number(orderValue);
        if (!Number.isNaN(parsedOrder)) {
          order = parsedOrder;
        }
      }
    }

    // Ensure order is a number if it exists (handle string "156" -> 156)
    if (order !== undefined && order !== null) {
      const numOrder = Number(order);
      if (!Number.isNaN(numOrder)) {
        order = numOrder;
      } else {
        order = undefined;
      }
    }

    const frontmatter = {
      ...parsed.frontmatter,
      order: order,
    };

    return {
      frontmatter: frontmatter,
      content: content,
    };
  })
  .sort((a, b) => {
    const orderA = a.frontmatter.order ?? 0;
    const orderB = b.frontmatter.order ?? 0;

    return orderB - orderA;
  });
---

<Layout>
  <div class="flex flex-col h-screen overflow-hidden">
    <div class="flex items-center justify-center py-3 md:py-6">
      <a href="/" target="_self">
        <span
          class="title-gradient-text font-medium text-2xl md:text-4xl font-heading mt-2 md:mt-4"
          >Rhymes by z0xm</span
        >
      </a>
    </div>
    <RhymeSelector client:load rhymes={rhymes} />
  </div>
</Layout>

<style>
  .title-gradient-text {
    background: linear-gradient(
      to bottom,
      var(--color-theme-peach-1),
      var(--color-theme-peach-2)
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
</style>
