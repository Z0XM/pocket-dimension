---
import FilterSort from "../components/FilterSort.svelte";
import RhymeSelector from "../components/RhymeSelector.svelte";
import { parseRhymes } from "../lib/rhymes";
import Layout from "../layouts/Layout.astro";

const rhymeModules = import.meta.glob("../assets/rhymes/*.md", { eager: true });
const rawRhymeModules = import.meta.glob("../assets/rhymes/*.md", {
  eager: true,
  query: "?raw",
});

const rhymes = parseRhymes(rhymeModules, rawRhymeModules);
---

<Layout>
  <div class="flex flex-col h-screen overflow-hidden">
    <div class="flex items-start justify-between gap-4 px-4 py-4 md:px-6 md:py-5">
      <div>
        <a href="/" target="_self" class="block">
          <span class="font-medium text-2xl shrink-0 whitespace-nowrap md:text-4xl font-heading text-theme-peach-1">
            rhymes
          </span>
        </a>
        <p class="mt-2 max-w-xl text-xs md:text-sm text-theme-peach-3">
          Browse, filter, and read without leaving the page.
        </p>
      </div>
      <div class="flex justify-end pt-1">
        <FilterSort client:load rhymes={rhymes} />
      </div>
    </div>
    <RhymeSelector client:load rhymes={rhymes} useFiltered={true} />
  </div>
</Layout>
