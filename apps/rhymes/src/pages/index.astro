---
import FilterSort from "../components/FilterSort.svelte";
import RhymeSelector from "../components/RhymeSelector.svelte";
import { parseRhymes } from "../lib/rhymes";
import Layout from "../layouts/Layout.astro";

const rhymeModules = import.meta.glob("../assets/rhymes/*.md", { eager: true });
const rawRhymeModules = import.meta.glob("../assets/rhymes/*.md", {
  eager: true,
  query: "?raw",
});

const rhymes = parseRhymes(rhymeModules, rawRhymeModules);
---

<Layout>
  <div class="flex flex-col h-screen overflow-hidden">
    <div class="flex items-center justify-between px-4 py-3 md:py-6">
      <div class="flex-1"></div>
      <div class="flex items-center justify-center flex-1">
        <a href="/" target="_self">
          <span
            class="title-gradient-text font-medium text-2xl shrink-0 whitespace-nowrap md:text-4xl font-heading mt-2 md:mt-4"
            >Rhymes by z0xm
          </span>
        </a>
      </div>
      <div class="flex-1 flex justify-end">
        <FilterSort client:load rhymes={rhymes} />
      </div>
    </div>
    <RhymeSelector client:load rhymes={rhymes} useFiltered={true} />
  </div>
</Layout>

<style>
  .title-gradient-text {
    background: linear-gradient(
      to bottom,
      var(--color-theme-peach-1),
      var(--color-theme-peach-2)
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
</style>
