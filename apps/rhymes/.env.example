# Local development
NODE_ENV=development
PORT=3003

# Auth service (must match auth-service env)
PUBLIC_BASE_AUTH_URL=http://localhost:5001
PUBLIC_BASE_AUTH_PATH=/

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

BETTER_AUTH_SECRET=replace-with-better-auth-secret
BETTER_AUTH_URL=http://localhost:5001
BETTER_AUTH_PATH=/
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5001,http://localhost:3003
BETTER_AUTH_COOKIE_DOMAIN=localhost

RESEND_API_KEY=re_placeholder_local_dev_only
RESEND_FROM_EMAIL=noreply@example.com

# Set to false after markdown import to serve catalog from DB only
RHYMES_USE_MARKDOWN_CATALOG=true

# Title art (disabled by default — enable with RHYMES_TITLE_ART_ENABLED=true and S3 config below)
RHYMES_TITLE_ART_ENABLED=false
# When title art is enabled, use object storage (not local disk)
RHYMES_ASSET_DRIVER=s3
RHYMES_ASSET_PUBLIC_BASE_URL=
# RHYMES_S3_BUCKET=
# RHYMES_S3_REGION=auto
# RHYMES_S3_ENDPOINT=
# RHYMES_S3_PREFIX=rhymes
# RHYMES_S3_ACCESS_KEY_ID=
# RHYMES_S3_SECRET_ACCESS_KEY=

RAILPACK_BUILD_CMD=bun install --frozen-lockfile && bun build:app:rhymes
RAILPACK_START_CMD=cd apps/rhymes && bun run start
