{
  "name": "@pocket-dimension/rhymes",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "start": "bun ./build/index.js",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "typecheck": "bun run check",
    "test": "bun test src/lib/visibility.test.ts src/lib/server/drafts.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/playwrite-us-modern": "^5.2.7",
    "@fontsource/playwrite-de-grund-guides": "^5.2.6",
    "@fontsource/playwrite-us-modern-guides": "^5.2.6",
    "@pocket-dimension/auth": "workspace:*",
    "@pocket-dimension/db": "workspace:*",
    "@tailwindcss/vite": "^4.3.0",
    "better-auth": "^1.4.10",
    "drizzle-orm": "^0.45.1",
    "gray-matter": "^4.0.3",
    "marked": "^17.0.1",
    "svelte": "^5.48.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.66.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/bun": "^1.3.14",
    "svelte-adapter-bun": "^1.0.1",
    "svelte-check": "^4.6.0",
    "vite": "^8.0.16"
  }
}
