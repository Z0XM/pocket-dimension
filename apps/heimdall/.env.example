# Heimdall — local / Dokploy environment
#
# No auth DB. War Room serves BMAD markdown from HEIMDALL_REPO_ROOT (_bmad-output + heimdall.config.mjs).
# Copy these into the Dokploy service Environment panel (`.env.example` is not auto-loaded).

NODE_ENV=production
PORT=3012
HOST=0.0.0.0

# Absolute path to the monorepo root that contains heimdall.config.mjs and _bmad-output/.
# Docker image sets this to /app. Leave unset for local `bun run start` from apps/heimdall
# (defaults to ../.. from the app).
# HEIMDALL_REPO_ROOT=/app

# Optional: override Fastify mount / public base.
# Pocket Dimension defaults to site root via heimdall.config.mjs (`heimdallPath: "/"`).
# Set these only if you need a path prefix again (e.g. /heimdall).
# HEIMDALL_MOUNT_PATH=/
# HEIMDALL_BASE_PATH=/
