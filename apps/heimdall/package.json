{
  "name": "@pocket-dimension/heimdall",
  "version": "0.2.1",
  "description": "Repo-agnostic BMAD / docs War Room (SPA + CLI)",
  "private": true,
  "type": "module",
  "main": "./dist/host.cjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/host.cjs",
      "import": "./dist/host.cjs",
      "default": "./dist/host.cjs"
    },
    "./config": {
      "types": "./src/config/index.ts",
      "default": "./src/config/index.ts"
    },
    "./server": "./server/apiState.ts",
    "./host": {
      "types": "./src/index.ts",
      "require": "./dist/host.cjs",
      "import": "./dist/host.cjs",
      "default": "./dist/host.cjs"
    }
  },
  "bin": {
    "heimdall": "bin/heimdall.cjs"
  },
  "files": [
    "bin",
    "src",
    "server",
    "dist",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "README.md",
    "AGENTS.md",
    "docs"
  ],
  "scripts": {
    "heimdall": "node ./bin/heimdall.cjs",
    "dev": "node ./bin/heimdall.cjs dev",
    "build": "node scripts/build-host.mjs && vite build",
    "build:host": "node scripts/build-host.mjs",
    "build:ui": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "start": "bun ./scripts/start.mjs",
    "start:local": "bun --env-file=.env ./scripts/start.mjs",
    "check": "bun run typecheck && bun run test && bun run build",
    "lint": "prettier --check .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/http-proxy": "^11.0.0",
    "@fastify/static": "^8.0.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fastify": "^5.6.0",
    "lucide-react": "^1.28.0",
    "minisearch": "^7.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.6.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.3",
    "vite": "^6.3.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.4.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "esbuild": "^0.25.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=18"
  }
}
