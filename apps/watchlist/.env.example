NODE_ENV=development
PORT=3002

PUBLIC_BASE_AUTH_URL=http://localhost:5001
PUBLIC_BASE_AUTH_PATH='/'

# Deploy from monorepo root (/), not apps/watchlist — see DEPLOY.md
RAILPACK_CONFIG_FILE=apps/watchlist/railpack.json
RAILPACK_BUILD_CMD=./apps/watchlist/scripts/deploy-build.sh
RAILPACK_START_CMD=cd apps/watchlist && bun run start

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

BETTER_AUTH_SECRET=

BETTER_AUTH_URL=http://localhost:5001

BETTER_AUTH_PATH='/'

BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5001,http://localhost:3002

BETTER_AUTH_COOKIE_DOMAIN=localhost

RESEND_API_KEY=

RESEND_FROM_EMAIL=noreply@z0xm.com
