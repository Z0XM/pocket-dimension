NODE_ENV=development
DEV_MODE=false
PORT=3002

PUBLIC_BASE_AUTH_URL=http://localhost:5001
PUBLIC_BASE_AUTH_PATH='/'

# Deploy from monorepo root (/), not apps/watchlist — see DEPLOY.md
RAILPACK_CONFIG_FILE=apps/watchlist/railpack.json
RAILPACK_BUILD_CMD=./apps/watchlist/scripts/deploy-build.sh
RAILPACK_START_CMD=cd apps/watchlist && bun run start

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

BETTER_AUTH_SECRET=

BETTER_AUTH_URL=http://localhost:5001

BETTER_AUTH_PATH='/'

BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5001,http://localhost:3002

BETTER_AUTH_COOKIE_DOMAIN=localhost

RESEND_API_KEY=

RESEND_FROM_EMAIL=noreply@z0xm.com

# --- Bunko auto account import ---
# Master switch for in-process cron (also respect admin DB toggle on /admin/connectors)
BUNKO_IMPORT_ENABLED=false
# Set to false on extra replicas if watchlist scales >1 instance
# BUNKO_IMPORT_CRON_ENABLED=true
BUNKO_IMPORT_USERNAME=lordsparos
# Must be contributor/admin (defaults to BUNKO_IMPORT_USERNAME)
# BUNKO_CATALOG_ACTOR_USERNAME=lordsparos
BUNKO_BASE_URL=https://bunko.byimti.tools
BUNKO_PAGE_SIZE=100
BUNKO_DEFAULT_LANGUAGE=English
BUNKO_IMPORT_CRON=0 6 * * *
# Optional status query filter (watched | watchlist); empty = all
# BUNKO_STATUS_FILTER=
# Required for non-admin HTTP manual sync (Authorization: Bearer … or X-Bunko-Sync-Secret)
BUNKO_SYNC_SECRET=
