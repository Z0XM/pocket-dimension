NODE_ENV=development
PORT=3007
HOST=0.0.0.0

# Set to your public URL when deployed behind Dokploy/reverse proxy
# ORIGIN=https://pocket.example.com

# App URLs — only apps with a URL set will appear on the hub
POCKET_APP_WATCHLIST_URL=http://localhost:3002
POCKET_APP_RHYMES_URL=http://localhost:3003
POCKET_APP_HOWWASYOURDAY_URL=http://localhost:3004
POCKET_APP_CHHAN_CHAN_URL=http://localhost:3005
POCKET_APP_ME_VIA_YOU_URL=http://localhost:3006
POCKET_APP_MARKITDOWN_URL=http://localhost:3006

# --- Dokploy + Railpack ---
# Build type: Railpack
# Root directory: / (monorepo root)
# RAILPACK_BUILD_CMD=bun install --frozen-lockfile && bun build:app:pocket
# RAILPACK_START_CMD=cd apps/pocket && bun run start
