# Local development
NODE_ENV=development
DEV_MODE=false
PORT=3013

# Auth service (must match auth-service env)
PUBLIC_BASE_AUTH_URL=http://localhost:5001
PUBLIC_BASE_AUTH_PATH=/

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

BETTER_AUTH_SECRET=replace-with-better-auth-secret
BETTER_AUTH_URL=http://localhost:5001
BETTER_AUTH_PATH=/
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5001,http://localhost:3013
BETTER_AUTH_COOKIE_DOMAIN=localhost

RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com

# Cloudflare R2 (S3 API) — required for uploads
# Create credentials: Cloudflare Dashboard → R2 → Manage R2 API Tokens
# (NOT Account API Tokens / global Cloudflare keys)
#
# Path-style (recommended):
#   S3_ENDPOINT = https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   Do NOT put the bucket name in the endpoint URL.
# Virtual-hosted (also OK — Zap auto-detects):
#   S3_ENDPOINT = https://<BUCKET>.<ACCOUNT_ID>.r2.cloudflarestorage.com
#
# Aliases accepted: S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY
# Strip quotes and trailing spaces when pasting secrets.
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=zap-media
S3_REGION=auto

# Phase 3 URL ingest (yt-dlp) — optional cookies for YouTube bot checks
# Fat Dockerfile installs yt-dlp + ffmpeg + Deno. Local: put yt-dlp on PATH or set YT_DLP_BIN.
# YT_DLP_BIN=/home/ubuntu/bin/yt-dlp
# YTDLP_COOKIES_FILE=/path/to/cookies.txt
# YTDLP_COOKIES_B64= (base64 Netscape cookies.txt — preferred for Dokploy)
# YTDLP_COOKIES= (inline cookies; \n escaped OK)

# Phase 4 — Connect YouTube (Google Cloud OAuth client for Zap)
# Redirect URI: https://<zap-host>/api/auth/youtube/callback (and http://localhost:3013/... for local)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional: encrypt tokens with a dedicated secret (falls back to BETTER_AUTH_SECRET)
# YOUTUBE_TOKEN_SECRET=
# Optional Data API key for public metadata (mine=true still uses OAuth)
# YOUTUBE_DATA_API_KEY=

# Phase 5 — Discord session sink (output only; not login)
# DISCORD_BOT_TOKEN=
# DISCORD_CLIENT_ID=   (or DISCORD_APPLICATION_ID) — for invite URL
# Invite needs Connect + Speak + View Channel. Bot must be in the guild before channel pick.

# Production URL — required behind a reverse proxy for correct redirects/links
# ORIGIN=https://zap.example.com

# Deploy from monorepo root (/), not apps/zap — see DEPLOY.md
RAILPACK_CONFIG_FILE=apps/zap/railpack.json
RAILPACK_BUILD_CMD=./apps/zap/scripts/deploy-build.sh
RAILPACK_START_CMD=cd apps/zap && bun run start
