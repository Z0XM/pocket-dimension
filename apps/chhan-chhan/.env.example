# Local development
NODE_ENV=development
PORT=3005

# Auth service (must match auth-service env)
PUBLIC_BASE_AUTH_URL=http://localhost:5001
PUBLIC_BASE_AUTH_PATH=/

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

BETTER_AUTH_SECRET=replace-with-better-auth-secret
BETTER_AUTH_URL=http://localhost:5001
BETTER_AUTH_PATH=/
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5001,http://localhost:3005
BETTER_AUTH_COOKIE_DOMAIN=localhost

RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com

# PDF/CSV statement imports (default adapter limit is 512K)
BODY_SIZE_LIMIT=10M

# Production URL — required behind a reverse proxy for correct redirects/links
# ORIGIN=https://chhan.example.com

# Deploy from monorepo root (/), not apps/chhan-chhan — see DEPLOY.md
RAILPACK_CONFIG_FILE=apps/chhan-chhan/railpack.json
RAILPACK_BUILD_CMD=./apps/chhan-chhan/scripts/deploy-build.sh
RAILPACK_START_CMD=cd apps/chhan-chhan && bun run start
