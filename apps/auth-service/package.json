{
  "name": "@pocket-dimension/auth-service",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "echo 'No build step needed - Bun runs TypeScript directly'",
    "dev": "bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "lint": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@elysiajs/swagger": "^1.3.1",
    "@pocket-dimension/auth": "workspace:*",
    "@pocket-dimension/db": "workspace:*",
    "@pocket-dimension/utils": "workspace:*",
    "elysia": "^1.4.19",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  }
}
