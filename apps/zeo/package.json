    "@tailwindcss/vite": "^4.1.17",
    "svelte": "^5.45.6",
    "svelte-adapter-bun": "^1.0.1",
    "svelte-check": "^4.3.4",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/fira-mono": "^5.2.7",
