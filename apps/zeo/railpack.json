{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "bun": "1.3.5"
  },
  "steps": {
    "install": {
      "commands": ["bun install"]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": ["./apps/zeo/scripts/deploy-build.sh"]
    }
  },
  "deploy": {
    "startCommand": "cd apps/zeo && bun run start",
    "variables": {
      "NODE_ENV": "production",
      "PORT": "3008"
    }
  }
}
