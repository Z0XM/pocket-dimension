# Zeo production environment (Dokploy + Railpack)
# Set these in Dokploy → zeo app → Environment (not on the VPS filesystem).
# Legacy Caddy/systemd: copy to /etc/zeo/env (chmod 600).
# See apps/zeo/deploy/dokploy/README.md

# Railpack (build type: Railpack, root directory: monorepo root)
RAILPACK_CONFIG_FILE=apps/zeo/railpack.json
# RAILPACK_INSTALL_CMD=bun install

NODE_ENV=production
PORT=3008
ORIGIN=https://zeo.z0xm.com

# PostgreSQL 18+ — Dokploy internal hostname, or localhost for legacy VPS
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/postgres

# Better Auth — must match auth-service exactly
BETTER_AUTH_SECRET=CHANGE_ME_SAME_AS_AUTH_SERVICE
BETTER_AUTH_URL=https://auth.z0xm.com
BETTER_AUTH_PATH=/
BETTER_AUTH_TRUSTED_ORIGINS=https://zeo.z0xm.com,https://auth.z0xm.com
BETTER_AUTH_COOKIE_DOMAIN=.z0xm.com

PUBLIC_BASE_AUTH_URL=https://auth.z0xm.com
PUBLIC_BASE_AUTH_PATH=/

RESEND_API_KEY=re_production_key
RESEND_FROM_EMAIL=noreply@z0xm.com

# LiveKit — keys from Dokploy LiveKit template (Compose → Environment → API_KEY / API_SECRET)
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME
LIVEKIT_URL=https://zeo-livekit.z0xm.com
PUBLIC_LIVEKIT_URL=wss://zeo-livekit.z0xm.com

# --- TURN / ICE (optional) ---
# Default: LiveKit embedded TURN (turn.enabled in livekit.prod.yaml) supplies ICE
# credentials automatically during join — leave these unset.
#
# Only set when using external coturn (see deploy/coturn/):
# LIVEKIT_TURN_HOST=zeo-livekit.z0xm.com
# LIVEKIT_TURN_USERNAME=zeo
# LIVEKIT_TURN_CREDENTIAL=CHANGE_ME
# LIVEKIT_TURN_TLS=true

# --- auth-service reference (/etc/auth-service/env or Dokploy env) ---
# PORT=5001
# DATABASE_URL=postgresql://...
# BETTER_AUTH_SECRET=<same as above>
# BETTER_AUTH_URL=https://auth.z0xm.com
# BETTER_AUTH_TRUSTED_ORIGINS=...,https://zeo.z0xm.com
# RESEND_API_KEY=...

# --- LiveKit (Dokploy template livekit.yaml keys block) ---
# Copy API_KEY / API_SECRET from Dokploy LiveKit template env
# Add webhook via deploy/livekit/dokploy-template-overlay.yaml.example
