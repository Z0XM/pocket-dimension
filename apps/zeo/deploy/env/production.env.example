# Zeo production environment (Dokploy + Railpack)
# Set in Dokploy → zeo app → Environment. See apps/zeo/deploy/dokploy/README.md

RAILPACK_BUILD_CMD=bun install --frozen-lockfile && bun build:app:zeo
RAILPACK_START_CMD=cd apps/zeo && bun run start

NODE_ENV=production
PORT=3008
ORIGIN=https://zeo.z0xm.com

DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/postgres

BETTER_AUTH_SECRET=CHANGE_ME_SAME_AS_AUTH_SERVICE
BETTER_AUTH_URL=https://auth.z0xm.com
BETTER_AUTH_PATH=/
BETTER_AUTH_TRUSTED_ORIGINS=https://zeo.z0xm.com,https://auth.z0xm.com
BETTER_AUTH_COOKIE_DOMAIN=.z0xm.com

PUBLIC_BASE_AUTH_URL=https://auth.z0xm.com
PUBLIC_BASE_AUTH_PATH=/

RESEND_API_KEY=re_production_key
RESEND_FROM_EMAIL=noreply@z0xm.com

LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME
LIVEKIT_URL=https://zeo-livekit.z0xm.com
PUBLIC_LIVEKIT_URL=wss://zeo-livekit.z0xm.com

# Shared Listening (requires separate music-worker Dockerfile app — see apps/zeo-music-worker/README.md)
PUBLIC_ZEO_URL=https://zeo.z0xm.com
PUBLIC_ZEO_ORIGIN=https://zeo.z0xm.com
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
YOUTUBE_DATA_API_KEY=CHANGE_ME
YOUTUBE_TOKEN_SECRET=CHANGE_ME_MIN_32_CHARS
# Dokploy Swarm: service name only — e.g. http://pocketdimension-zeomusicworker-qqj6xp:3010
# Do NOT use the task hostname with .1.<taskid> (ConnectionRefused after redeploy).
MUSIC_WORKER_URL=http://pocketdimension-zeomusicworker-XXXXXX:3010
MUSIC_WORKER_SECRET=CHANGE_ME_SHARED_WITH_WORKER
