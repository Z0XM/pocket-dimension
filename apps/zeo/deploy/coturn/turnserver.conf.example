# Copy to turnserver.conf and replace secrets + public IP.
# Generate long-term credential: turnadmin -a -u zeo -r z0xm.com -p YOUR_SECRET

listening-port=3478
tls-listening-port=5349
listening-ip=0.0.0.0
relay-ip=YOUR_VPS_PUBLIC_IP
external-ip=YOUR_VPS_PUBLIC_IP

fingerprint
lt-cred-mech
realm=z0xm.com
server-name=zeo-turn.z0xm.com

# Static auth (alternative: use REST API with zeo token mint)
user=zeo:REPLACE_WITH_TURN_PASSWORD

min-port=49152
max-port=65535

no-cli
no-tlsv1
no-tlsv1_1

# TLS cert paths if terminating TURN TLS on coturn directly (optional — Caddy/LiveKit may handle TLS)
# cert=/etc/letsencrypt/live/zeo-livekit.z0xm.com/fullchain.pem
# pkey=/etc/letsencrypt/live/zeo-livekit.z0xm.com/privkey.pem
