NODE_ENV=development
PORT=3004

PUBLIC_BASE_AUTH_URL=http://localhost:5001
PUBLIC_BASE_AUTH_PATH=/

RAILPACK_BUILD_CMD=bun install --frozen-lockfile && bun build:app:howwasyourday
RAILPACK_START_CMD=cd apps/howwasyourday && bun run start

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

BETTER_AUTH_SECRET=local-dev-better-auth-secret
BETTER_AUTH_URL=http://localhost:5001
BETTER_AUTH_PATH=/
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5001,http://localhost:3004
BETTER_AUTH_COOKIE_DOMAIN=localhost

RESEND_API_KEY=re_placeholder_local_dev_only
RESEND_FROM_EMAIL=noreply@example.com

PUBLIC_VAPID_KEY=local-dev-public-vapid-key
VAPID_PRIVATE_KEY=local-dev-private-vapid-key
VAPID_SUBJECT=mailto:admin@example.com
