NODE_ENV=development
DEV_MODE=false
PORT=3004

PUBLIC_BASE_AUTH_URL=http://localhost:5001
PUBLIC_BASE_AUTH_PATH='/'

# Deploy from monorepo root (/), not apps/howwasyourday — see DEPLOY.md
RAILPACK_CONFIG_FILE=apps/howwasyourday/railpack.json
RAILPACK_BUILD_CMD=./apps/howwasyourday/scripts/deploy-build.sh
RAILPACK_START_CMD=cd apps/howwasyourday && bun run start

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

BETTER_AUTH_SECRET=

BETTER_AUTH_URL=http://localhost:5001

BETTER_AUTH_PATH='/'

BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5001,http://localhost:3004

BETTER_AUTH_COOKIE_DOMAIN=localhost

RESEND_API_KEY=

RESEND_FROM_EMAIL=noreply@z0xm.com

# Optional: HMAC secret for 30-day legacy recap claim cookies (falls back to BETTER_AUTH_SECRET)
# LEGACY_RECAP_CLAIM_SECRET=

# With DEV_MODE=true and NODE_ENV=development, claim pages show “Skip OTP (local dev)”
# (POST /api/recap/2025/otp/bypass). Production never enables this.

# Import script only (local ops — never commit export dirs or email maps)
# YEAR_RECAP_EXPORT_DIR=/path/to/year-recap/dashboard
# YEAR_RECAP_EMAILS_FILE=./scripts/legacy-recap-emails.json

PUBLIC_VAPID_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@z0xm.com
