PORT=3010
MUSIC_WORKER_SECRET=dev-music-worker-secret
ZEO_APP_URL=http://127.0.0.1:3008

# Required on most VPS/datacenter IPs — Netscape cookies.txt for youtube.com
# Export via incognito → youtube.com/robots.txt (see README).
# YTDLP_COOKIES_FILE=/path/to/cookies.txt
#
# Dokploy-friendly (single-line): base64 of cookies.txt
#   base64 -w0 cookies.txt   # Linux
#   base64 -i cookies.txt | tr -d '\n'   # macOS
# YTDLP_COOKIES_B64=IyBOZXRzY2FwZS4uLg==
#
# Or raw contents (only if your env UI supports real multiline / literal \n):
# YTDLP_COOKIES=# Netscape HTTP Cookie File\n.youtube.com\tTRUE\t/\tTRUE\t0\tNAME\tVALUE
