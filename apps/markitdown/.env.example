NODE_ENV=development
PORT=3006
HOST=0.0.0.0

# Local dev: run `bun run setup:python` to create `.venv`
# Production: deploy-build.sh installs to `python-packages/`
PYTHON_PATH=.venv/bin/python
PYTHON_PACKAGES_DIR=python-packages

# Required for 50 MB file uploads (SvelteKit default is 512 KB)
BODY_SIZE_LIMIT=52428800

# Set to your public URL when deployed behind Dokploy/reverse proxy
# ORIGIN=https://markitdown.example.com

# MarkItDown runtime paths (set automatically by Railpack deploy config)
# EXIFTOOL_PATH=/usr/bin/exiftool
# FFMPEG_PATH=/usr/bin/ffmpeg

# --- Dokploy + Railpack ---
# Build type: Railpack
# Root directory: / (monorepo root)
#
# Option A (recommended): use railpack.json
# RAILPACK_CONFIG_FILE=apps/markitdown/railpack.json
#
# Option B: explicit env vars (if not using railpack.json)
# RAILPACK_BUILD_CMD=./apps/markitdown/scripts/deploy-build.sh
# RAILPACK_START_CMD=cd apps/markitdown && bun run start
# RAILPACK_PACKAGES=python@3.12
# RAILPACK_BUILD_APT_PACKAGES=ffmpeg,libimage-exiftool-perl
# RAILPACK_DEPLOY_APT_PACKAGES=ffmpeg,libimage-exiftool-perl

# Do not use `bun run build` — it builds every app in the monorepo.
RAILPACK_CONFIG_FILE=apps/markitdown/railpack.json
RAILPACK_BUILD_CMD=./apps/markitdown/scripts/deploy-build.sh
RAILPACK_START_CMD=cd apps/markitdown && bun run start
