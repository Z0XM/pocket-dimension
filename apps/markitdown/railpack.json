{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "bun": "1.3.5",
    "python": "3.12"
  },
  "buildAptPackages": ["ffmpeg", "libimage-exiftool-perl"],
  "steps": {
    "build": {
      "commands": ["./apps/markitdown/scripts/deploy-build.sh"]
    }
  },
  "deploy": {
    "aptPackages": ["ffmpeg", "libimage-exiftool-perl"],
    "startCommand": "cd apps/markitdown && bun run start",
    "variables": {
      "NODE_ENV": "production",
      "HOST": "0.0.0.0",
      "PYTHON_PATH": ".venv/bin/python",
      "EXIFTOOL_PATH": "/usr/bin/exiftool",
      "FFMPEG_PATH": "/usr/bin/ffmpeg",
      "BODY_SIZE_LIMIT": "52428800"
    }
  }
}
