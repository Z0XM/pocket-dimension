{
  "name": "@pocket-dimension/db",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --format esm --target bun --external better-auth --external drizzle-orm --external pg --external zod --external @pocket-dimension/utils",
    "clean": "rm -rf dist",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate": "bunx --bun drizzle-kit migrate",
    "db:studio": "bunx --bun drizzle-kit studio",
    "db:drop": "bunx --bun drizzle-kit drop",
    "auth:generate": "better-auth generate --config ./src/lib/auth.ts"
  },
  "dependencies": {
    "@pocket-dimension/utils": "workspace:*",
    "better-auth": "^1.4.10",
    "drizzle-orm": "^0.45.1",
    "pg": "^8.16.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.16.0",
    "@better-auth/cli": "^1.4.9",
    "drizzle-kit": "^0.31.8",
    "typescript": "latest"
  }
}
